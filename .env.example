# App
NEXT_PUBLIC_APP_NAME=MimeBookmark
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (Optional - for paid features)
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry Error Tracking (optional)
# Get these from your Sentry project settings
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=  # For source maps upload

# Umami Analytics (optional)
# Get these from your Umami instance at https://umami.is/
# NEXT_PUBLIC_UMAMI_URL=https://umami.example.com
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id
